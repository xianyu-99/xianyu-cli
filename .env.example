# YuCLI 配置示例
# 用法：
# 1. 复制本文件为 .env
# 2. 按需填写下面的配置项
# 3. 未填写的项会回退到代码默认值

# ========== Anthropic 兼容 API 配置（默认）==========
# API Key（必填，使用 DeepSeek Anthropic 兼容端点）
ANTHROPIC_API_KEY=your_api_key_here
# Claude Code 兼容别名；如果你已有 ANTHROPIC_AUTH_TOKEN，也可以不填 ANTHROPIC_API_KEY
# ANTHROPIC_AUTH_TOKEN=your_api_key_here
# Base URL（可选，默认 https://api.deepseek.com/anthropic）
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
# 模型名称（可选，默认 deepseek-v4-pro）
# ANTHROPIC_MODEL=deepseek-v4-pro

# ========== GLM 配置 ==========
# API Key（备选，需通过环境变量 GLM_API_KEY 或 /model 命令切换）
# GLM_API_KEY=your_api_key_here
# Base URL（可选，默认 https://open.bigmodel.cn/api/coding/paas/v4/chat/completions）
# GLM_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
# 模型名称（可选，默认 glm-5.1）
# GLM_MODEL=glm-5.1

# ========== DeepSeek 配置（OpenAI 兼容端点）==========
# API Key（备选，需通过环境变量 DEEPSEEK_API_KEY 或 /model 命令切换）
# DEEPSEEK_API_KEY=your_deepseek_api_key_here
# Base URL（可选，默认 https://api.deepseek.com/chat/completions）
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# 模型名称（可选，默认 deepseek-v4-flash）
# DEEPSEEK_MODEL=deepseek-v4-flash

# ========== Qwen 配置（OpenAI 兼容端点）==========
# API Key（备选，需通过环境变量 QWEN_API_KEY 或 /model 命令切换）
# QWEN_API_KEY=your_qwen_api_key_here
# Base URL（可选，默认 https://dashscope.aliyuncs.com/compatible-mode/v1）
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 模型名称（可选，默认 qwen3-coder-plus）
# QWEN_MODEL=qwen3-coder-plus

# ========== 通用 OpenAI 兼容配置 ==========
# 可用于 OpenAI 官方或第三方 OpenAI-compatible 网关。
# 注意：YuCLI 当前走 chat/completions wire，不读取 Codex 的 ~/.codex/config.toml / auth.json。
# OPENAI_API_KEY=your_openai_compatible_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o

# Embedding 配置（用于 /index、/search、Agent 的代码检索）
# 支持 provider：ollama / openai / zhipu / glm
# 不配置时默认使用 ollama + nomic-embed-text:latest + http://localhost:11434
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text:latest
EMBEDDING_BASE_URL=http://localhost:11434

# 如果使用需要鉴权的远程 Embedding 服务，再打开这一项
# EMBEDDING_API_KEY=your_api_key_here

# ========== Web 搜索配置 ==========
# 选择搜索 provider（zhipu | serpapi | searxng），不配置时按 Key/URL 自动判断：
# 1. 有 GLM_API_KEY → zhipu（默认推荐：与 GLM 推理共用 Key，零额外配置，国内首选）
# 2. 有 SERPAPI_KEY → serpapi（国际通用，付费即开即用）
# 3. 有 SEARXNG_URL → searxng（开源自托管，免费，需本地跑 docker 实例）
# SEARCH_PROVIDER=zhipu

# 智谱 Web Search 引擎（SEARCH_PROVIDER=zhipu 时启用）
# 可选：search_std（0.01 元/次，默认）、search_pro（0.03 元/次）、
#       search_pro_sogou（0.05 元/次，搜狗）、search_pro_quark（0.05 元/次，夸克）
# 中文搜索建议用 search_pro 或搜狗 / 夸克版本，效果优于通用 std
# ZHIPU_SEARCH_ENGINE=search_std

# SerpAPI Key（SEARCH_PROVIDER=serpapi 时启用）
# 免费 100 次/月：https://serpapi.com/manage-api-key
# SERPAPI_KEY=your_serpapi_key_here

# SearXNG 实例地址（SEARCH_PROVIDER=searxng 时启用）
# 本地 docker：docker run --rm -p 8888:8888 searxng/searxng
# 公共实例（不稳定，仅试玩）：见 https://searx.space
# SEARXNG_URL=http://localhost:8888

# ========== Web 抓取配置 ==========
# web_fetch 工具：抓取 URL 并提取正文 Markdown
# 当前实现走「直接 HTTP + Jsoup + 简易 readability」，对静态/SSR 页面有效
# 对 SPA / 防爬墙站点会返回空正文（已知边界，待第 13/14 期 CDP 路线接入）
# 默认安全策略：屏蔽 file:// / 内网 / loopback；30 秒超时；5MB 响应上限；每分钟 30 次限流

# ========== MCP 配置 ==========
# MCP server 配置文件位置：
# 1. 用户级 ~/.YuCLI/mcp.json
# 2. 项目级 .YuCLI/mcp.json（按 server 名覆盖用户级）
# 支持 ${PROJECT_DIR}、${HOME} 和环境变量 ${VAR} 展开。
# 远程 Streamable HTTP server 常用 token 示例：
# REMOTE_TOKEN=your_remote_mcp_token_here

# ========== 命令 Sandbox（可选，默认关闭）==========
# execute_command 可通过 Docker 在容器中执行，提供进程级隔离和容器文件系统边界。
# 启用前需要本机已安装 Docker，并建议提前拉取镜像：
#   docker pull maven:3.9-eclipse-temurin-17
# YUCLI_SANDBOX_ENABLED=true
# YUCLI_SANDBOX_DOCKER=docker
# YUCLI_SANDBOX_DOCKER_IMAGE=maven:3.9-eclipse-temurin-17
# 默认关闭容器网络；如确实需要联网安装依赖，可改为 bridge
# YUCLI_SANDBOX_NETWORK=none
# 项目目录挂载到容器 /workspace；rw 允许构建输出和代码生成，ro 更安全但很多命令会失败
# YUCLI_SANDBOX_MOUNT=rw
# 可选资源限制
# YUCLI_SANDBOX_MEMORY=2g
# YUCLI_SANDBOX_CPUS=2

# ========== LLM HTTP 超时（可选）==========
# SSE 流式接口下，readTimeout 是"两次 read 之间最大间隔"。
# GLM-5.1 在生成大段 reasoning_content 时服务端可能长时间静默，超时容易触发。
# 仅当遇到频繁 "调用 LLM 失败: timeout" 时再调大；通过 -D 系统属性传入：
#   java -DYuCLI.llm.read.timeout.seconds=600 -jar target/yucli-19.0.0.jar
# 默认值：connect=60s / read=300s / write=60s / call=600s

# 日志配置（支持自动滚动、压缩和清理）
# 默认日志目录：~/.YuCLI/logs
# 默认日志文件：~/.YuCLI/logs/YuCLI.log
# 日志级别可选：ERROR / WARN / INFO / DEBUG
YuCLI_LOG_LEVEL=INFO

# 日志目录。建议填绝对路径
YuCLI_LOG_DIR=/Users/yourname/.YuCLI/logs

# 最多保留多少天的历史日志
YuCLI_LOG_MAX_HISTORY=7

# 单个日志文件滚动前的最大体积
YuCLI_LOG_MAX_FILE_SIZE=10MB

# 所有归档日志允许占用的总容量，超出后会自动清理更老的日志
YuCLI_LOG_TOTAL_SIZE_CAP=100MB

# ========== 操作审计配置 ==========
# 危险工具（write_file / execute_command / create_project）调用会按天写一行 JSONL 审计
# 默认目录：~/.YuCLI/audit/audit-YYYY-MM-DD.jsonl
# 也可通过 -DYuCLI.audit.dir=/path/to/dir 系统属性覆盖
# YuCLI_AUDIT_DIR=/Users/yourname/.YuCLI/audit
